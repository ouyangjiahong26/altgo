// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
// 不 extends @docusaurus/tsconfig：它的 baseUrl 在 TypeScript 7 已被移除，
// 继承会报 TS5102，这里把除 baseUrl 外的选项原样内联。
{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": [".docusaurus", "build", "node_modules"]
}
